{
  "openapi": "3.1.0",
  "info": {
    "title": "Reform Platform API",
    "version": "1.0.0",
    "description": "리폼·수선·복원 업체 검색 플랫폼의 Mobile REST API 명세입니다."
  },
  "servers": [
    {
      "url": "/",
      "description": "현재 서버"
    }
  ],
  "tags": [
    {
      "name": "Reference",
      "description": "카테고리·서비스·지역·브랜드 기준 정보"
    },
    {
      "name": "Business",
      "description": "공개 업체 조회"
    },
    {
      "name": "Event",
      "description": "사용자 행동 이벤트"
    },
    {
      "name": "Search",
      "description": "통합 검색 및 검색어 제안"
    }
  ],
  "paths": {
    "/api/v1/categories": {
      "get": {
        "tags": ["Reference"],
        "summary": "카테고리 목록 조회",
        "operationId": "listCategories",
        "parameters": [
          {
            "name": "parentId",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1}
          },
          {
            "name": "level",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "활성 카테고리 목록",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CategoryListSuccessResponse"}
              }
            }
          },
          "422": {
            "description": "유효하지 않은 조회 조건",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "tags": ["Reference"],
        "summary": "서비스 목록 조회",
        "operationId": "listServices",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1}
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "활성 서비스 목록",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ServiceListSuccessResponse"}
              }
            }
          },
          "404": {
            "description": "카테고리를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "422": {
            "description": "유효하지 않은 조회 조건",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      }
    },
    "/api/v1/regions": {
      "get": {
        "tags": ["Reference"],
        "summary": "지역 목록 조회",
        "operationId": "listRegions",
        "parameters": [
          {
            "name": "parentId",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1}
          },
          {
            "name": "level",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "활성 지역 목록",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RegionListSuccessResponse"}
              }
            }
          },
          "422": {
            "description": "유효하지 않은 조회 조건",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      }
    },
    "/api/v1/brands": {
      "get": {
        "tags": ["Reference"],
        "summary": "브랜드 목록 조회",
        "operationId": "listBrands",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {"type": "string"}
          },
          {
            "name": "page",
            "in": "query",
            "schema": {"type": "integer", "minimum": 1, "default": 1}
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "활성 브랜드 목록",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/BrandListSuccessResponse"}
              }
            }
          },
          "422": {
            "description": "유효하지 않은 조회 조건",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "tags": ["Event"],
        "summary": "사용자 행동 이벤트 기록",
        "operationId": "createEvent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/EventCreateRequest"}
            }
          }
        },
        "responses": {
          "204": {
            "description": "이벤트 기록 성공"
          },
          "400": {
            "description": "JSON 요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "422": {
            "description": "이벤트 입력값 검증 실패",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      }
    },
    "/api/v1/search/suggestions": {
      "get": {
        "tags": ["Search"],
        "summary": "검색어 제안 조회",
        "operationId": "getSearchSuggestions",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "minLength": 1}
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "업체·서비스·브랜드 검색어 제안",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SearchSuggestionsSuccessResponse"}
              }
            }
          },
          "422": {
            "description": "검색어 또는 제한 수 검증 실패",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"}
              }
            }
          }
        }
      }
    },
    "/api/v1/businesses": {
      "get": {
        "tags": [
          "Business"
        ],
        "summary": "업체 목록 조회",
        "description": "공개 조건을 만족하는 업체를 게시일 최신순으로 조회합니다. 검색과 필터는 후속 API 범위입니다.",
        "operationId": "listBusinesses",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "페이지 번호",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "description": "페이지당 업체 수",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "업체 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessListSuccessResponse"
                }
              }
            }
          },
          "422": {
            "description": "유효하지 않은 페이지 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "입력값을 확인해주세요."
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/businesses/{id}": {
      "get": {
        "tags": [
          "Business"
        ],
        "summary": "업체 상세 조회",
        "description": "ACTIVE 상태이고 삭제되지 않았으며 게시 시각이 도달한 업체의 핵심 정보와 자체·외부 평판을 조회합니다.",
        "operationId": "getBusiness",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "업체 ID",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 123
          }
        ],
        "responses": {
          "200": {
            "description": "업체 상세 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessSuccessResponse"
                }
              }
            }
          },
          "404": {
            "description": "업체가 없거나 공개 조건을 만족하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "BUSINESS_NOT_FOUND",
                    "message": "업체를 찾을 수 없습니다."
                  }
                }
              }
            }
          },
          "422": {
            "description": "유효하지 않은 업체 ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "입력값을 확인해주세요."
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchSuggestionsSuccessResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "data": {
            "type": "object",
            "required": ["businesses", "services", "brands"],
            "properties": {
              "businesses": {
                "type": "array",
                "items": {"$ref": "#/components/schemas/SearchSuggestion"}
              },
              "services": {
                "type": "array",
                "items": {"$ref": "#/components/schemas/SearchSuggestion"}
              },
              "brands": {
                "type": "array",
                "items": {"$ref": "#/components/schemas/SearchSuggestion"}
              }
            }
          }
        }
      },
      "SearchSuggestion": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"}
        }
      },
      "EventCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventName"],
        "properties": {
          "sessionKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "eventName": {
            "type": "string",
            "enum": [
              "SEARCH",
              "FILTER",
              "BUSINESS_IMPRESSION",
              "BUSINESS_VIEW",
              "BUSINESS_CLICK",
              "FAVORITE",
              "CALL_CLICK",
              "MAP_CLICK",
              "WEBSITE_CLICK",
              "SNS_CLICK",
              "CASE_VIEW",
              "SHARE",
              "EXTERNAL_GOOGLE_CLICK",
              "EXTERNAL_NAVER_CLICK",
              "REVIEW_VIEW",
              "REVIEW_CREATE",
              "REVIEW_UPDATE",
              "REVIEW_DELETE"
            ]
          },
          "entityType": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "entityId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "metadata": {
            "type": "object",
            "description": "Token, 비밀번호, API Key 등 민감정보를 포함할 수 없습니다.",
            "additionalProperties": true
          }
        }
      },
      "CategoryListSuccessResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "data": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Category"}
          }
        }
      },
      "ServiceListSuccessResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "data": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Service"}
          }
        }
      },
      "RegionListSuccessResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "data": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Region"}
          }
        }
      },
      "BrandListSuccessResponse": {
        "type": "object",
        "required": ["success", "data", "meta"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "data": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/Brand"}
          },
          "meta": {"$ref": "#/components/schemas/PaginationMeta"}
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "parentId", "name", "slug", "description", "sortOrder"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "parentId": {"type": ["integer", "null"], "format": "int64"},
          "name": {"type": "string"},
          "slug": {"type": "string"},
          "description": {"type": ["string", "null"]},
          "sortOrder": {"type": "integer"}
        }
      },
      "Service": {
        "type": "object",
        "required": ["id", "name", "slug", "description", "sortOrder"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"},
          "slug": {"type": "string"},
          "description": {"type": ["string", "null"]},
          "sortOrder": {"type": "integer"}
        }
      },
      "Region": {
        "type": "object",
        "required": ["id", "parentId", "code", "name", "slug", "level", "sortOrder"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "parentId": {"type": ["integer", "null"], "format": "int64"},
          "code": {"type": ["string", "null"]},
          "name": {"type": "string"},
          "slug": {"type": "string"},
          "level": {"type": "integer", "minimum": 1},
          "sortOrder": {"type": "integer"}
        }
      },
      "Brand": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"},
          "slug": {"type": "string"}
        }
      },
      "BusinessListSuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessSummary"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": [
          "page",
          "perPage",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "BusinessSuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/Business"
          }
        }
      },
      "BusinessSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "shortDescription",
          "supports",
          "publishedAt",
          "reputation"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "name": {
            "type": "string",
            "example": "ABC 가죽공방"
          },
          "slug": {
            "type": "string",
            "example": "abc-leather"
          },
          "shortDescription": {
            "type": [
              "string",
              "null"
            ],
            "example": "가죽 제품을 복원합니다."
          },
          "supports": {
            "$ref": "#/components/schemas/BusinessSupports"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-15T00:00:00Z"
          },
          "reputation": {
            "$ref": "#/components/schemas/BusinessReputation"
          }
        }
      },
      "Business": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "shortDescription",
          "description",
          "phone",
          "supports",
          "publishedAt",
          "reputation"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "name": {
            "type": "string",
            "example": "ABC 가죽공방"
          },
          "slug": {
            "type": "string",
            "example": "abc-leather"
          },
          "shortDescription": {
            "type": [
              "string",
              "null"
            ],
            "example": "가죽 제품을 복원합니다."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "example": "02-1234-5678"
          },
          "supports": {
            "$ref": "#/components/schemas/BusinessSupports"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-15T00:00:00Z"
          },
          "reputation": {
            "$ref": "#/components/schemas/BusinessReputation"
          }
        }
      },
      "BusinessSupports": {
        "type": "object",
        "required": [
          "shipping",
          "visit",
          "pickup"
        ],
        "properties": {
          "shipping": {
            "type": "boolean"
          },
          "visit": {
            "type": "boolean"
          },
          "pickup": {
            "type": "boolean"
          }
        }
      },
      "BusinessReputation": {
        "type": "object",
        "required": [
          "internal",
          "external"
        ],
        "properties": {
          "internal": {
            "$ref": "#/components/schemas/InternalReputation"
          },
          "external": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalReputation"
            }
          }
        }
      },
      "InternalReputation": {
        "type": "object",
        "required": [
          "rating",
          "reviewCount",
          "favoriteCount",
          "workCaseCount"
        ],
        "properties": {
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "minimum": 1,
            "maximum": 5,
            "example": 4.8
          },
          "reviewCount": {
            "type": "integer",
            "minimum": 0,
            "example": 24
          },
          "favoriteCount": {
            "type": "integer",
            "minimum": 0,
            "example": 52
          },
          "workCaseCount": {
            "type": "integer",
            "minimum": 0,
            "example": 18
          }
        }
      },
      "ExternalReputation": {
        "type": "object",
        "required": [
          "provider",
          "rating",
          "reviewCount",
          "url"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "GOOGLE",
              "NAVER"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "minimum": 1,
            "maximum": 5,
            "example": 4.6
          },
          "reviewCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "example": 128
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/google-place"
          }
        }
