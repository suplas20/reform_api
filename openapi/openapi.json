{
  "openapi": "3.1.0",
  "info": {
    "title": "Reform Platform API",
    "version": "1.0.0",
    "description": "리폼·수선·복원 업체 검색 플랫폼의 Mobile REST API 명세입니다."
  },
  "servers": [
    {
      "url": "/",
      "description": "현재 서버"
    }
  ],
  "tags": [
    {
      "name": "Business",
      "description": "공개 업체 조회"
    }
  ],
  "paths": {
    "/api/v1/businesses": {
      "get": {
        "tags": [
          "Business"
        ],
        "summary": "업체 목록 조회",
        "description": "공개 조건을 만족하는 업체를 게시일 최신순으로 조회합니다. 검색과 필터는 후속 API 범위입니다.",
        "operationId": "listBusinesses",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "페이지 번호",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "description": "페이지당 업체 수",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "업체 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessListSuccessResponse"
                }
              }
            }
          },
          "422": {
            "description": "유효하지 않은 페이지 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_PAGINATION",
                    "message": "페이지 정보가 올바르지 않습니다."
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/businesses/{id}": {
      "get": {
        "tags": [
          "Business"
        ],
        "summary": "업체 상세 조회",
        "description": "ACTIVE 상태이고 삭제되지 않았으며 게시 시각이 도달한 업체의 핵심 정보와 자체·외부 평판을 조회합니다.",
        "operationId": "getBusiness",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "업체 ID",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 123
          }
        ],
        "responses": {
          "200": {
            "description": "업체 상세 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessSuccessResponse"
                }
              }
            }
          },
          "404": {
            "description": "업체가 없거나 공개 조건을 만족하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "BUSINESS_NOT_FOUND",
                    "message": "업체를 찾을 수 없습니다."
                  }
                }
              }
            }
          },
          "422": {
            "description": "유효하지 않은 업체 ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_BUSINESS_ID",
                    "message": "업체 ID가 올바르지 않습니다."
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusinessListSuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessSummary"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": [
          "page",
          "perPage",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "BusinessSuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/Business"
          }
        }
      },
      "BusinessSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "shortDescription",
          "supports",
          "publishedAt",
          "reputation"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "name": {
            "type": "string",
            "example": "ABC 가죽공방"
          },
          "slug": {
            "type": "string",
            "example": "abc-leather"
          },
          "shortDescription": {
            "type": [
              "string",
              "null"
            ],
            "example": "가죽 제품을 복원합니다."
          },
          "supports": {
            "$ref": "#/components/schemas/BusinessSupports"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-15T00:00:00Z"
          },
          "reputation": {
            "$ref": "#/components/schemas/BusinessReputation"
          }
        }
      },
      "Business": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "shortDescription",
          "description",
          "phone",
          "supports",
          "publishedAt",
          "reputation"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "name": {
            "type": "string",
            "example": "ABC 가죽공방"
          },
          "slug": {
            "type": "string",
            "example": "abc-leather"
          },
          "shortDescription": {
            "type": [
              "string",
              "null"
            ],
            "example": "가죽 제품을 복원합니다."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "example": "02-1234-5678"
          },
          "supports": {
            "$ref": "#/components/schemas/BusinessSupports"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-15T00:00:00Z"
          },
          "reputation": {
            "$ref": "#/components/schemas/BusinessReputation"
          }
        }
      },
      "BusinessSupports": {
        "type": "object",
        "required": [
          "shipping",
          "visit",
          "pickup"
        ],
        "properties": {
          "shipping": {
            "type": "boolean"
          },
          "visit": {
            "type": "boolean"
          },
          "pickup": {
            "type": "boolean"
          }
        }
      },
      "BusinessReputation": {
        "type": "object",
        "required": [
          "internal",
          "external"
        ],
        "properties": {
          "internal": {
            "$ref": "#/components/schemas/InternalReputation"
          },
          "external": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalReputation"
            }
          }
        }
      },
      "InternalReputation": {
        "type": "object",
        "required": [
          "rating",
          "reviewCount",
          "favoriteCount",
          "workCaseCount"
        ],
        "properties": {
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "minimum": 1,
            "maximum": 5,
            "example": 4.8
          },
          "reviewCount": {
            "type": "integer",
            "minimum": 0,
            "example": 24
          },
          "favoriteCount": {
            "type": "integer",
            "minimum": 0,
            "example": 52
          },
          "workCaseCount": {
            "type": "integer",
            "minimum": 0,
            "example": 18
          }
        }
      },
      "ExternalReputation": {
        "type": "object",
        "required": [
          "provider",
          "rating",
          "reviewCount",
          "url"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "GOOGLE",
              "NAVER"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "minimum": 1,
            "maximum": 5,
            "example": 4.6
          },
          "reviewCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "example": 128
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/google-place"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
