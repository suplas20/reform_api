{
    "name": "reform-platform/server",
    "description": "Korean reform business discovery platform backend and public web",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "monolog/monolog": "^3.0",
        "swagger-api/swagger-ui": "^5.32.15",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/smoke.php",
            "@php tests/naver_login.php",
            "@php tests/kakao_login.php",
            "@php tests/google_login.php",
            "@php tests/semas_import.php",
            "@php tests/administrative_regions.php",
            "@php tests/administrative_region_sync.php",
            "@php tests/business_api.php",
            "@php tests/reference_api.php",
            "@php tests/event_api.php",
            "@php tests/search_api.php",
            "@php tests/public_content_api.php",
            "@php tests/api_documentation.php"
        ],
        "db:check": "@php bin/check-database.php",
        "db:migrate": "@php bin/migrate.php migrate",
        "db:status": "@php bin/migrate.php status",
        "db:seed": "@php bin/seed.php all",
        "db:seed:reference": "@php bin/seed.php reference",
        "db:seed:demo": "@php bin/seed.php demo",
        "db:import:semas": "@php bin/import-semas-businesses.php all",
        "db:import:semas:collect": "@php bin/import-semas-businesses.php collect",
        "db:import:semas:classify": "@php bin/import-semas-businesses.php classify",
        "db:import:semas:sync": "@php bin/import-semas-businesses.php sync",
        "db:import:regions": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/import-administrative-regions.php collect"
        ],
        "db:import:regions:status": "@php bin/import-administrative-regions.php status",
        "db:import:regions:plan": "@php bin/sync-administrative-regions.php plan",
        "db:import:regions:sync": "@php bin/sync-administrative-regions.php apply",
        "db:import:region-centers:plan": "@php bin/import-region-centers.php plan",
        "db:import:region-centers": "@php bin/import-region-centers.php apply",
        "test:seed": "@php tests/seed_data.php",
        "test:database": [
            "@php tests/database_schema.php",
            "@php tests/public_repository.php",
            "@php tests/region_selection_repository.php",
            "@php tests/region_centers.php",
            "@php tests/business_location_search.php",
            "@php tests/business_region_fallback.php",
            "@php tests/business_sorting.php",
            "@php tests/app_api_integration.php",
            "@php tests/administrative_region_repository.php",
            "@php tests/administrative_region_sync_repository.php"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 0.0.0.0:8080 -t public"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
