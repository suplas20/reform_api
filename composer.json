{
    "name": "reform-platform/server",
    "description": "Korean reform business discovery platform backend and public web",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "monolog/monolog": "^3.0",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "@php tests/smoke.php",
        "serve": "@php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
